# Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY mediflow_backend_requirements.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy application code
COPY mediflow_app_*.py ./app/
COPY mediflow_app_core_*.py ./app/core/
COPY mediflow_app_models_*.py ./app/models/
COPY mediflow_app_routers_*.py ./app/routers/
COPY mediflow_app_schemas_*.py ./app/schemas/

# Create __init__ files
RUN touch ./app/__init__.py \
    && touch ./app/core/__init__.py \
    && touch ./app/models/__init__.py \
    && touch ./app/routers/__init__.py \
    && touch ./app/schemas/__init__.py

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Run application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
