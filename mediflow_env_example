# Backend Configuration
APP_NAME=MediFlow
APP_VERSION=1.0.0
DEBUG=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5432/mediflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRE_SECONDS=3600

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://mediflow.com

# External Services
OPENAI_API_KEY=sk-your-key-here
GOOGLE_CLOUD_VISION_KEY_PATH=/path/to/google/credentials.json

# S3
S3_BUCKET=mediflow-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Feature Flags
ENABLE_OCR=true
ENABLE_RAG=true
ENABLE_DRUG_INTERACTIONS=true
